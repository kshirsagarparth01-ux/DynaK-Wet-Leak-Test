<Window x:Class="DynaK.WetLeakTest.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DynaK Wet Leak Test Station"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="720"
        Icon="Assets/dynak-parc-app-icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#121416">
  <Grid Background="#121416">
    <wv2:WebView2 x:Name="HmiWebView"
                  Visibility="Collapsed"
                  AllowDrop="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

    <Grid x:Name="StartupOverlay" Background="#121416">
      <Border Width="520"
              Padding="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="#1E2022"
              BorderBrush="#424752"
              BorderThickness="1"
              CornerRadius="4">
        <StackPanel>
          <Image Source="pack://application:,,,/Assets/dynak-header.png"
                 Width="432"
                 Height="40"
                 Margin="0,0,0,28"
                 HorizontalAlignment="Center"
                 Stretch="Uniform" />
          <TextBlock x:Name="StartupStatus"
                     Text="Starting application..."
                     Foreground="#E2E2E5"
                     FontFamily="Segoe UI"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextAlignment="Center" />
          <TextBlock x:Name="StartupDetail"
                     Margin="0,12,0,0"
                     Foreground="#C2C6D4"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <StackPanel x:Name="StartupActions"
                      Margin="0,28,0,0"
                      HorizontalAlignment="Center"
                      Orientation="Horizontal"
                      Visibility="Collapsed">
            <Button x:Name="RetryButton"
                    Width="120"
                    Height="44"
                    Margin="0,0,8,0"
                    Click="RetryButton_Click"
                    Background="#005FB8"
                    BorderBrush="#A8C8FF"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Content="RETRY" />
            <Button Width="120"
                    Height="44"
                    Margin="8,0,0,0"
                    Click="ExitButton_Click"
                    Background="#282A2C"
                    BorderBrush="#8C919D"
                    Foreground="#E2E2E5"
                    FontWeight="SemiBold"
                    Content="EXIT" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
